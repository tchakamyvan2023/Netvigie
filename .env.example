# ============================================================
# NETVIGIE — Configuration d'environnement
# Copier ce fichier en .env et adapter si nécessaire
# ============================================================

# --- Application ---
APP_NAME=NETVIGIE
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_SECRET_KEY=CHANGEME_AVEC_UNE_CLE_ALEATOIRE_64_CARACTERES

# --- Frontend ---
FRONTEND_URL=http://192.168.1.40:3000
CORS_ORIGINS=http://192.168.1.40:3000,http://localhost:3000

# --- Base de données PostgreSQL ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=netvigie
POSTGRES_USER=netvigie
POSTGRES_PASSWORD=Netvigie2026!

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# --- Wazuh API ---
WAZUH_API_URL=https://192.168.1.50:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh
WAZUH_API_VERIFY_SSL=false

# --- Wazuh Indexer (OpenSearch) ---
WAZUH_INDEXER_URL=https://192.168.1.50:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=admin
WAZUH_INDEXER_VERIFY_SSL=false

# --- Agent 01 — Collector ---
COLLECTOR_INTERVAL_SECONDS=10
COLLECTOR_ALERT_LOOKBACK_SECONDS=300

# --- Agent 02 — Diagnostic ---
DIAGNOSTIC_INTERVAL_SECONDS=15
DIAGNOSTIC_PING_TIMEOUT_SECONDS=2

# --- Agent 03 — Security ---
SECURITY_INTERVAL_SECONDS=10

# --- Agent 04 — Correlation ---
CORRELATION_INTERVAL_SECONDS=20
CORRELATION_TIME_WINDOW_SECONDS=60
CORRELATION_PRECEDENCE_THRESHOLD_MS=200

# --- Authentification ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Admin initial (créé par init_db.py) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@netvigie.local
ADMIN_PASSWORD=AdminNetvigie2026!

# --- Logs ---
LOG_LEVEL=INFO
LOG_DIR=./data/logs